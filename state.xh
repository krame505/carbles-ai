#include <unification.xh>
#include <list.xh>
#include <map.xh>
#include <prolog_utils.xh>
#include <string.xh>
#include <vector.xh>
#include <json.xh>
#include <stdlib.h>

#ifndef _STATE_XH
#define _STATE_XH

#define SECTOR_SIZE 18
#define NUM_PIECES 4
#define FINISH_BACKTRACK_DIST 2
#define DECK_SIZE 54 * 2
#define MIN_HAND 4
#define MAX_HAND 5
#define MAX_PLAYERS 12

typedef unsigned PlayerId;

string showPlayerId(PlayerId p, arena_t ar);

#define PLAYER_ID_NONE ((PlayerId)-1)

PlayerId partner(unsigned numPlayers, PlayerId p);

datatype Position {
  Out(unsigned ?);
  Finish(PlayerId ?, unsigned ?);
};
typedef datatype Position Position;

size_t showPositionMaxLen(Position p);
size_t showPosition(char buf[], Position p);
show datatype Position with showPositionMaxLen, showPosition;

static inline int comparePosition(Position p1, Position p2) {
  return match (p1, p2)
    (Finish(_, _), Out(_) -> 1;
     Out(_), Finish(_, _) -> -1;
     Finish(?&a, _), Finish(?&b, _) @when (a != b) -> a - b;
     Finish(_, ?&i), Finish(_, ?&j) -> i - j;
     Out(?&i), Out(?&j) -> i - j;);
}

static inline int compareUnsigned(unsigned x, unsigned y) {
  return x - y;
}

typedef map<Position, PlayerId, comparePosition> Board;
typedef map<PlayerId, unsigned, compareUnsigned> Lot;

datatype State {
  St(unsigned ?numPlayers, _Bool ?partners,
     Board ?board, Lot ?lot);
};
typedef datatype State State;

string showState(State s, arena_t ar);
State copyState(State s, arena_t ar);

unsigned numPlayers(State);
_Bool partners(State);

enum Card {
  Joker, A,
  J = 11, Q, K,
  CARD_MAX
};
typedef enum Card Card;

datatype Move {
  MoveOut(PlayerId ?);
  MoveDirect(Position ?from, Position ?to);
  Swap(Position ?, Position ?);
};
typedef datatype Move Move;

string showMove(Move m, PlayerId p1, PlayerId p2, arena_t ar);
string showMoves(list<Move ?> ?m, PlayerId p1, PlayerId p2, arena_t ar);

typedef unsigned Hand[CARD_MAX];

size_t showHandMaxLen(const Hand h);
size_t showHand(char buf[], const Hand h);
show Hand with showHandMaxLen, showHand;
show (const Hand) with showHandMaxLen, showHand; // This is a different type since the qualifier attaches on the element type

datatype Action {
  Play(Card, list<Move ?> ?);
  Burn(Card);
};
typedef datatype Action Action;

string showAction(Action a, PlayerId p1, PlayerId p2, arena_t ar);
string showActions(vector<Action> a, PlayerId p1, PlayerId p2, arena_t ar);

Card getActionCard(Action);
list<Move ?> ?getActionMoves(Action);

Json jsonState(State s, arena_t);
Json jsonHands(unsigned numPlayers, const Hand hands[numPlayers], arena_t);
Json jsonActions(vector<Action> a, PlayerId p1, PlayerId p2, arena_t);

Position copyPosition(Position, arena_t);
Move copyMove(Move, arena_t);
list<Move ?> ?copyMoves(list<Move ?> ?, arena_t);

void initializeDeck(Hand);
unsigned getDeckSize(const Hand);
unsigned deal(unsigned min, unsigned max, Hand deck, unsigned numPlayers, Hand hands[numPlayers]);

State initialState(unsigned numPlayers, _Bool partners, arena_t ar);
State applyMove(Move, State, arena_t ar);
State applyMoves(list<Move ?> ?, State, arena_t ar);
State applyAction(Action, State, Hand, Hand discard, arena_t ar);

_Bool cardHasMoves(State s, PlayerId p, Card c);
vector<list<Move ?> ?> getCardMoves(State s, PlayerId p, Card c, arena_t);
vector<Action> getActions(State s, PlayerId p, const Hand h, arena_t);
_Bool actionPossible(State s, PlayerId p, const Hand h, const Hand partnerHand);
_Bool isWon(State s);
PlayerId getWinner(State s);

prolog {
  move(State, Move, State ?);
  moves(State, list<Move ?>, State ?);

#include "state_utils.pl"
}

#endif
